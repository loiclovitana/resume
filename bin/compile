#!/usr/bin/env bash
# Compile .tex files into build/<name>.pdf with aux files under build/<name>/
# No LaTeX is installed locally, so we compile inside a TeX Live container.
set -euo pipefail

cd "$(dirname "$0")/.."

IMAGE="texlive/texlive:latest"

mkdir -p build

# Prefer docker, fall back to podman.
if command -v docker >/dev/null 2>&1; then
    RUNNER=docker
elif command -v podman >/dev/null 2>&1; then
    RUNNER=podman
else
    echo "error: neither docker nor podman found" >&2
    exit 1
fi

# If no arguments given, compile all .tex files in the project root.
if [[ $# -eq 0 ]]; then
    set -- *.tex
fi

for SRC in "$@"; do
    NAME="$(basename "${SRC%.tex}")"
    mkdir -p "build/$NAME"
    "$RUNNER" run --rm \
        -v "$PWD:/work" -w /work \
        "$IMAGE" \
        latexmk -pdf -interaction=nonstopmode -halt-on-error \
            -output-directory=build \
            -auxdir="build/$NAME" \
            "$SRC"
    echo "==> build/$NAME.pdf"
done
